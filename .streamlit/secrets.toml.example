# คัดลอกไฟล์นี้เป็น .streamlit/secrets.toml แล้วใส่ค่าจริง (secrets.toml ไม่ถูก commit ขึ้น GitHub)
#
# ตอนรันบน Streamlit Community Cloud ไม่ต้องสร้างไฟล์นี้ในเครื่อง —
# ไปตั้งค่าคีย์เดียวกันนี้ในหน้า "Settings" > "Secrets" ของแอปบน share.streamlit.io แทน

GEMINI_API_KEY = "ใส่ Gemini API key ของคุณ"
ADMIN_PASSWORD = "ใส่รหัสผ่าน admin ที่ต้องการ"
DATABASE_URL = "postgresql://user:password@host/dbname?sslmode=require"
